# Copy this file to .env and fill in your values

# Required for Railway/production
GEMINI_API_KEY=your-google-gemini-api-key
JWT_SECRET=replace-with-a-long-random-secret
PORT=10000

# Optional AI model (falls back to gemini-flash-latest if unavailable)
GEMINI_MODEL=gemini-3.6-flash

# Optional MongoDB (app continues with SQLite if connection fails)
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Optional: allow your frontend domain(s) to talk to this API
CORS_ORIGINS=https://anish0985.github.io
